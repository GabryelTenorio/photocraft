[Desktop Entry]
Type=Application
Name=PhotoCraft
GenericName=Image Editor
Comment=Edit photos and layered PSD documents
Exec=photocraft %F
TryExec=photocraft
Icon=ai.storyteller.photocraft
Terminal=false
# The native runner does not complete desktop startup-notification handshakes.
StartupNotify=false
# The window class. X11 matches StartupWMClass against the WM_CLASS class, and egui-winit sets
# that from the app_id "ai.storyteller.photocraft" (winit `with_name(app_id, "")`); on Wayland
# the app_id itself matches the desktop-file id, so this line is X11-only but must be exact.
StartupWMClass=ai.storyteller.photocraft
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;image;editor;psd;layers;retouch;paint;
MimeType=application/x-photocraft;image/x-paintnet;image/openraster;image/vnd.adobe.photoshop;image/x-psd;image/x-psb;image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-exr;image/vnd.radiance;image/avif;image/qoi;
